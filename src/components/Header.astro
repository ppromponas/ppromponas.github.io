---
const path = Astro.url.pathname;
const items: [string, string][] = [
  ['/', 'Home'],
  ['/research/', 'Research'],
  ['/publications/', 'Publications'],
  ['/cv/', 'CV'],
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<a class="skip" href="#main">Skip to content</a>
<header class="wrap site-header">
  <a class="brand" href="/">Panagiotis Promponas</a>
  <nav class="nav" aria-label="Main">
    {items.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="sun" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="moon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  function currentTheme(): 'dark' | 'light' {
    const t = root.getAttribute('data-theme');
    if (t === 'dark' || t === 'light') return t;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
