---
import Illustration from './Illustration.astro';
import { icons } from '../data/icons';
import type { CollectionEntry } from 'astro:content';

interface Props {
  pillars: CollectionEntry<'pillars'>[];
  threads: CollectionEntry<'threads'>[];
}
const { pillars, threads } = Astro.props;
const threadsOf = (id: string) =>
  threads.filter((t) => t.data.pillar === id).sort((a, b) => a.data.order - b.data.order);
---

<div class="pillars" data-pillars>
  {pillars.map((p) => (
    <div class="pillar" data-pillar={p.id}>
      <button class="pillar-hit" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls={`pop-${p.id}`}>
        <div class="pillar-art"><Illustration kind={p.data.illustration} /></div>
        <h3>{p.data.title}</h3>
        <p>{p.data.lead}</p>
      </button>
      <div class="pillar-threads">
        {threadsOf(p.id).map((t) => <a href={`/research/${p.id}/#${t.id}`}>{t.data.title}</a>)}
      </div>
      <span class="caret" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
      </span>
    </div>
  ))}

  {pillars.map((p) => (
    <div class="popover" id={`pop-${p.id}`} role="dialog" aria-label={p.data.title} hidden>
      <div class="popover-head">
        <span class="eyebrow">{p.data.title}</span>
        <button class="xbtn" type="button" aria-label="Close">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <a class="prow" href={`/research/${p.id}/`}>
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={icons.overview}></path></svg>
        <span><span class="pn">Overview of {p.data.title.toLowerCase()}</span><span class="pd">Everything in this area on one page.</span></span>
      </a>
      {threadsOf(p.id).map((t) => (
        <a class="prow" href={`/research/${p.id}/#${t.id}`}>
          <svg aria-hidden="true" width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={icons[t.id] ?? icons.default}></path></svg>
          <span><span class="pn">{t.data.title}</span><span class="pd">{t.data.summary}</span></span>
        </a>
      ))}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pillars]').forEach((root) => {
    const boxes = Array.from(root.querySelectorAll<HTMLElement>('.pillar'));
    let openId: string | null = null;

    function closeAll() {
      root.querySelectorAll<HTMLElement>('.popover').forEach((p) => (p.hidden = true));
      boxes.forEach((b) => {
        b.classList.remove('is-open');
        b.querySelector('.pillar-hit')?.setAttribute('aria-expanded', 'false');
      });
      openId = null;
    }

    function openFor(box: HTMLElement, x: number, y: number) {
      closeAll();
      const id = box.dataset.pillar;
      const pop = root.querySelector<HTMLElement>(`#pop-${id}`);
      if (!id || !pop) return;
      const r = root.getBoundingClientRect();
      let px = x - r.left + 10;
      const py = y - r.top + 12;
      const maxX = r.width - 416;
      if (px > maxX) px = maxX;
      if (px < 8) px = 8;
      pop.style.left = `${Math.round(px)}px`;
      pop.style.top = `${Math.round(py)}px`;
      pop.hidden = false;
      box.classList.add('is-open');
      box.querySelector('.pillar-hit')?.setAttribute('aria-expanded', 'true');
      openId = id;
      pop.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    }

    boxes.forEach((box) => {
      box.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a')) return;
        if (openId === box.dataset.pillar) { closeAll(); return; }
        let x = e.clientX, y = e.clientY;
        if (!x && !y) {
          const br = box.getBoundingClientRect();
          x = br.left + br.width / 2;
          y = br.top + br.height / 2;
        }
        openFor(box, x, y);
      });
    });

    root.querySelectorAll('.xbtn').forEach((b) => b.addEventListener('click', closeAll));
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (openId && !t.closest('.pillar') && !t.closest('.popover')) closeAll();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  });
</script>
