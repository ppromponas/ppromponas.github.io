---
// The living element: a slowly rotating 3D cloud of nodes behind the introduction,
// with entanglement-swap events drawn in the accent color.
interface Props { object?: 'cloud' | 'sphere'; bond?: 'wave' | 'arc' }
const { object = 'cloud', bond = 'wave' } = Astro.props;
---

<canvas class="living-graph" data-object={object} data-bond={bond} aria-hidden="true"></canvas>

<script>
  function isDark(): boolean {
    const t = document.documentElement.getAttribute('data-theme');
    if (t === 'dark') return true;
    if (t === 'light') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mode = canvas.dataset.object === 'sphere' ? 'sphere' : 'cloud';
    const bond = canvas.dataset.bond === 'arc' ? 'arc' : 'wave';

    const N = 84, SX = 1.35, TAU = 6.2832;
    let AS = 1, W = 0, H = 0, last = 0, gt = 0;
    let ry = 0, tx = 0.28, ty = 0, mx = 0, my = 0, inside = false;
    let dark = isDark();
    let INK = '22,22,22', ACC = '27,127,103';
    function recolor() { dark = isDark(); INK = dark ? '236,235,230' : '22,22,22'; ACC = dark ? '79,195,161' : '27,127,103'; }
    recolor();
    document.addEventListener('themechange', recolor);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);

    type P = { x: number; y: number; z: number; vx: number; vy: number; vz: number };
    type Q = { x: number; y: number; d: number };
    let pts: P[] = [], edges: [number, number][] = [], adj: number[][] = [];
    let swaps: { a: number; b: number; c: number; t: number }[] = [];
    const proj: Q[] = new Array(N);

    function seed() {
      pts = [];
      for (let i = 0; i < N; i++) {
        if (mode === 'sphere') {
          const u = Math.random(), v = Math.random();
          const th = 2 * Math.PI * u, ph = Math.acos(2 * v - 1);
          pts.push({ x: Math.sin(ph) * Math.cos(th) * SX, y: Math.sin(ph) * Math.sin(th), z: Math.cos(ph), vx: 0, vy: 0, vz: 0 });
        } else {
          let x, y, z;
          do { x = Math.random() * 2 - 1; y = Math.random() * 2 - 1; z = Math.random() * 2 - 1; } while (x * x + y * y + z * z > 1);
          pts.push({ x: x * SX, y, z, vx: (Math.random() - 0.5) * 0.0012, vy: (Math.random() - 0.5) * 0.0012, vz: (Math.random() - 0.5) * 0.0012 });
        }
      }
      const set: Record<string, 1> = {};
      edges = [];
      for (let a = 0; a < N; a++) {
        const d: [number, number][] = [];
        for (let b = 0; b < N; b++) {
          if (a === b) continue;
          const dx = pts[a].x - pts[b].x, dy = pts[a].y - pts[b].y, dz = pts[a].z - pts[b].z;
          d.push([dx * dx + dy * dy + dz * dz, b]);
        }
        d.sort((p, q) => p[0] - q[0]);
        for (let k = 0; k < 2; k++) {
          if (d[k][0] > 0.36) break;
          const j = d[k][1], key = a < j ? `${a}-${j}` : `${j}-${a}`;
          if (!set[key]) { set[key] = 1; edges.push([a, j]); }
        }
      }
      adj = Array.from({ length: N }, () => []);
      for (const [a, b] of edges) { adj[a].push(b); adj[b].push(a); }
    }

    function spawnSwap() {
      for (let tries = 0; tries < 12; tries++) {
        const b = (Math.random() * N) | 0;
        if (adj[b].length < 2) continue;
        const a = adj[b][(Math.random() * adj[b].length) | 0];
        const c = adj[b][(Math.random() * adj[b].length) | 0];
        if (a === c) continue;
        const busy = swaps.some((w) => [w.a, w.b, w.c].some((n) => n === a || n === b || n === c));
        if (busy) continue;
        swaps.push({ a, b, c, t: 0 });
        return;
      }
    }

    function resize() {
      const r = host!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = Math.max(1, r.width); H = Math.max(1, r.height);
      AS = W >= 860 ? 1 : 0.55;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function step(dt: number) {
      gt += dt;
      ry += 0.0022 * dt;
      const goalX = 0.28 + (inside ? (my - 0.5) * 0.5 : 0);
      const goalY = inside ? (mx - 0.5) * 0.6 : 0;
      tx += (goalX - tx) * 0.04 * dt;
      ty += (goalY - ty) * 0.04 * dt;
      if (mode === 'cloud') {
        for (const p of pts) {
          p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;
          const rr = (p.x / SX) * (p.x / SX) + p.y * p.y + p.z * p.z;
          if (rr > 1) { p.vx = -p.vx; p.vy = -p.vy; p.vz = -p.vz; }
        }
      }
      if (Math.random() < 0.012 * dt && swaps.length < 2 && edges.length) spawnSwap();
      for (const s of swaps) s.t += 0.011 * dt;
      swaps = swaps.filter((s) => s.t < 4.2);
    }

    function project() {
      const R = H * 0.4, cx = W >= 860 ? W * 0.72 : W / 2, cy = H / 2;
      const cy1 = Math.cos(ry + ty), sy1 = Math.sin(ry + ty), cx1 = Math.cos(tx), sx1 = Math.sin(tx);
      for (let i = 0; i < N; i++) {
        const p = pts[i];
        const x1 = p.x * cy1 + p.z * sy1, z1 = -p.x * sy1 + p.z * cy1, y1 = p.y;
        const y2 = y1 * cx1 - z1 * sx1, z2 = y1 * sx1 + z1 * cx1;
        const s = 2.9 / (2.9 - z2);
        proj[i] = { x: cx + x1 * R * s, y: cy + y2 * R * s, d: (z2 + 1) / 2 };
      }
    }

    function draw() {
      const c = ctx!;
      c.clearRect(0, 0, W, H);
      project();
      c.lineWidth = 1;
      for (const [i, j] of edges) {
        const a = proj[i], b = proj[j];
        const al = (0.05 + 0.2 * ((a.d + b.d) / 2)) * AS;
        c.strokeStyle = `rgba(${INK},${al.toFixed(3)})`;
        c.beginPath(); c.moveTo(a.x, a.y); c.lineTo(b.x, b.y); c.stroke();
      }
      const order = Array.from({ length: N }, (_, i) => i).sort((p, q) => proj[p].d - proj[q].d);
      for (const i of order) {
        const n = proj[i];
        const r = 1.0 + 2.2 * n.d, na = (0.16 + 0.64 * n.d) * AS;
        c.fillStyle = `rgba(${INK},${na.toFixed(3)})`;
        c.beginPath(); c.arc(n.x, n.y, r, 0, TAU); c.fill();
      }
      for (const sw of swaps) {
        const A = proj[sw.a], B = proj[sw.b], C = proj[sw.c], t = sw.t;
        const tr = Math.min(t, 1);
        const linkAlpha = t < 1.35 ? 1 : Math.max(0, 1 - (t - 1.35) / 0.45);
        if (linkAlpha > 0) {
          const x1 = A.x + (B.x - A.x) * tr, y1 = A.y + (B.y - A.y) * tr;
          const x2 = C.x + (B.x - C.x) * tr, y2 = C.y + (B.y - C.y) * tr;
          c.strokeStyle = `rgba(${ACC},${(0.7 * linkAlpha).toFixed(3)})`;
          c.lineWidth = 1.5;
          c.beginPath(); c.moveTo(A.x, A.y); c.lineTo(x1, y1); c.stroke();
          c.beginPath(); c.moveTo(C.x, C.y); c.lineTo(x2, y2); c.stroke();
          c.lineWidth = 1;
          if (t < 1) {
            c.fillStyle = `rgba(${ACC},0.95)`;
            c.beginPath(); c.arc(x1, y1, 2.8, 0, TAU); c.fill();
            c.beginPath(); c.arc(x2, y2, 2.8, 0, TAU); c.fill();
          }
          c.fillStyle = `rgba(${ACC},${(0.25 * linkAlpha).toFixed(3)})`;
          c.beginPath(); c.arc(A.x, A.y, 7, 0, TAU); c.fill();
          c.beginPath(); c.arc(C.x, C.y, 7, 0, TAU); c.fill();
        }
        if (t >= 1 && t < 1.6) {
          const rt = (t - 1) / 0.6;
          c.strokeStyle = `rgba(${ACC},${((1 - rt) * 0.8).toFixed(3)})`;
          c.lineWidth = 1.2;
          c.beginPath(); c.arc(B.x, B.y, 4 + 16 * rt, 0, TAU); c.stroke();
          c.lineWidth = 1;
        }
        if (t >= 1.35) {
          const grow = t < 2.4 ? (t - 1.35) / 1.05 : 1;
          const fade = t < 3.3 ? 1 : Math.max(0, 1 - (t - 3.3) / 0.9);
          const al = grow * fade;
          if (bond === 'arc') {
            const mx2 = (A.x + C.x) / 2, my2 = (A.y + C.y) / 2;
            const cpx = mx2 + (mx2 - B.x) * 0.35, cpy = my2 + (my2 - B.y) * 0.35;
            c.strokeStyle = `rgba(${ACC},${(0.85 * al).toFixed(3)})`;
            c.lineWidth = 1.6;
            c.beginPath(); c.moveTo(A.x, A.y); c.quadraticCurveTo(cpx, cpy, C.x, C.y); c.stroke();
            c.lineWidth = 1;
          } else {
            const ddx = C.x - A.x, ddy = C.y - A.y, len = Math.sqrt(ddx * ddx + ddy * ddy) || 1;
            const nx = -ddy / len, ny = ddx / len;
            const ease = grow * grow * (3 - 2 * grow);
            const amp = Math.min(7, 2.5 + len * 0.035) * ease * (0.6 + 0.4 * fade) * (0.92 + 0.08 * Math.sin(gt * 0.02));
            const cycles = Math.max(1.5, len / 65);
            const steps = Math.max(24, Math.round(len / 3));
            const ph = gt * 0.045;
            for (let wv = 0; wv < 2; wv++) {
              const sign = wv === 0 ? 1 : -1;
              c.strokeStyle = `rgba(${ACC},${((wv === 0 ? 0.85 : 0.45) * al).toFixed(3)})`;
              c.lineWidth = wv === 0 ? 1.5 : 1.1;
              c.beginPath();
              for (let s = 0; s <= steps; s++) {
                const u = s / steps;
                const env = Math.sin(Math.PI * u);
                const off = sign * amp * env * Math.sin(cycles * TAU * u + ph);
                const px = A.x + ddx * u + nx * off, py = A.y + ddy * u + ny * off;
                if (s === 0) c.moveTo(px, py); else c.lineTo(px, py);
              }
              c.stroke();
            }
            c.lineWidth = 1;
          }
          c.fillStyle = `rgba(${ACC},${(0.9 * al).toFixed(3)})`;
          c.beginPath(); c.arc(A.x, A.y, 3, 0, TAU); c.fill();
          c.beginPath(); c.arc(C.x, C.y, 3, 0, TAU); c.fill();
          c.fillStyle = `rgba(${ACC},${(0.22 * al).toFixed(3)})`;
          c.beginPath(); c.arc(A.x, A.y, 8, 0, TAU); c.fill();
          c.beginPath(); c.arc(C.x, C.y, 8, 0, TAU); c.fill();
        }
      }
    }

    let raf = 0;
    function loop(ts: number) {
      const dt = last ? Math.min((ts - last) / 16.67, 3) : 1;
      last = ts;
      if (!document.hidden) { step(dt); draw(); }
      raf = requestAnimationFrame(loop);
    }

    seed();
    resize();
    new ResizeObserver(resize).observe(host);
    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      mx = (e.clientX - r.left) / r.width; my = (e.clientY - r.top) / r.height; inside = true;
    });
    host.addEventListener('pointerleave', () => { inside = false; });
    if (reduce) { step(1); draw(); document.addEventListener('themechange', draw); }
    else raf = requestAnimationFrame(loop);
    void raf;
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.living-graph').forEach(start);
</script>
