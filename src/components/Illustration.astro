---
// The three minimal line illustrations for the research pillars.
interface Props { kind: 'quantum' | 'dqc' | 'control' }
const { kind } = Astro.props;
---

{kind === 'quantum' && (
  <svg role="img" aria-label="A switch joining four nodes, with an end-to-end pair drawn between two of them" viewBox="0 0 240 112" width="240" height="112" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M40 78 L120 58 L200 78 M120 58 L80 28 M120 58 L160 28" opacity="0.5"></path>
    <path d="M40 78 C 70 14, 170 14, 200 78" stroke="var(--accent)" stroke-width="1.75" stroke-dasharray="3 5"></path>
    <circle cx="40" cy="78" r="5" fill="var(--surface)"></circle>
    <circle cx="200" cy="78" r="5" fill="var(--surface)"></circle>
    <circle cx="80" cy="28" r="5" fill="var(--surface)"></circle>
    <circle cx="160" cy="28" r="5" fill="var(--surface)"></circle>
    <rect x="108" y="46" width="24" height="24" rx="7" fill="var(--surface)"></rect>
  </svg>
)}

{kind === 'dqc' && (
  <svg role="img" aria-label="Two quantum processors with an entanglement link between one qubit in each" viewBox="0 0 240 112" width="240" height="112" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="28" y="26" width="78" height="60" rx="14" opacity="0.7"></rect>
    <rect x="134" y="26" width="78" height="60" rx="14" opacity="0.7"></rect>
    <path d="M85 66 L155 46" stroke="var(--accent)" stroke-width="1.75" stroke-dasharray="3 5"></path>
    <circle cx="49" cy="46" r="4" fill="var(--surface)"></circle><circle cx="67" cy="46" r="4" fill="var(--surface)"></circle><circle cx="85" cy="46" r="4" fill="var(--surface)"></circle>
    <circle cx="49" cy="66" r="4" fill="var(--surface)"></circle><circle cx="67" cy="66" r="4" fill="var(--surface)"></circle><circle cx="85" cy="66" r="4" fill="var(--surface)" stroke="var(--accent)"></circle>
    <circle cx="155" cy="46" r="4" fill="var(--surface)" stroke="var(--accent)"></circle><circle cx="173" cy="46" r="4" fill="var(--surface)"></circle><circle cx="191" cy="46" r="4" fill="var(--surface)"></circle>
    <circle cx="155" cy="66" r="4" fill="var(--surface)"></circle><circle cx="173" cy="66" r="4" fill="var(--surface)"></circle><circle cx="191" cy="66" r="4" fill="var(--surface)"></circle>
  </svg>
)}

{kind === 'control' && (
  <svg role="img" aria-label="A node with three directional sectors, one of them active" viewBox="0 0 240 112" width="240" height="112" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M120 60 L85.4 40 A40 40 0 0 1 113.1 20.6 Z" opacity="0.55"></path>
    <path d="M120 60 L113.1 99.4 A40 40 0 0 1 85.4 80 Z" opacity="0.55"></path>
    <path d="M120 60 L154.6 40 A40 40 0 0 1 157.6 73.7 Z" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.75"></path>
    <circle cx="120" cy="60" r="5" fill="var(--surface)"></circle>
    <circle cx="196" cy="56" r="4" fill="var(--surface)" stroke="var(--accent)"></circle>
    <path d="M162 58 L190 56" stroke="var(--accent)" stroke-dasharray="3 5"></path>
  </svg>
)}
