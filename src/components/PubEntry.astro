---
import type { CollectionEntry } from 'astro:content';

interface Props { pub: CollectionEntry<'publications'>; showYear?: boolean }
const { pub, showYear = true } = Astro.props;
const d = pub.data;
const ME = 'P. Promponas';
const parts = d.authors.split(ME);
// One link per paper, carried by the title: publisher page first, then arXiv, then a hosted PDF.
const href = d.links?.ieee ?? d.links?.doi ?? d.links?.arxiv ?? d.links?.pdf;
---

<article class="pub" data-year={d.year} data-type={d.type} data-pillar={d.pillar} data-thread={d.thread}>
  {href ? <a class="pub-title" href={href}>{d.title}</a> : <span class="pub-title">{d.title}</span>}
  <div class="pub-authors">
    {parts.map((s, i) => (<>{s}{i < parts.length - 1 && <b>{ME}</b>}</>))}
  </div>
  <div class="pub-meta">
    <span>{d.venue}{showYear ? `, ${d.year}` : ''}</span>
    {d.badge && <span class="badge">{d.badge}</span>}
  </div>
</article>
