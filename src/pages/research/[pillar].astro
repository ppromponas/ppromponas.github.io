---
import Base from '../../layouts/Base.astro';
import PubEntry from '../../components/PubEntry.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const pillars = await getCollection('pillars');
  return pillars.map((pillar) => ({ params: { pillar: pillar.id }, props: { pillar } }));
}

interface Props { pillar: CollectionEntry<'pillars'> }
const { pillar } = Astro.props;
const { Content: PillarIntro } = await render(pillar);

const threads = (await getCollection('threads'))
  .filter((t) => t.data.pillar === pillar.id)
  .sort((a, b) => a.data.order - b.data.order);
const pubs = await getCollection('publications');

const sections = await Promise.all(
  threads.map(async (t) => ({
    t,
    Content: (await render(t)).Content,
    papers: pubs.filter((p) => p.data.thread === t.id).sort((a, b) => b.data.year - a.data.year),
    // A demo is a custom element: `media.tag` names it and the script in `media.src` defines it.
    Demo: t.data.media?.type === 'demo' ? t.data.media.tag : undefined,
  })),
);
// One script per demo on this page. They stay classic scripts (is:inline): a demo may read its own
// URL to find the files next to it, which a bundled or module script cannot do.
const demoScripts = [...new Set(threads.filter((t) => t.data.media?.type === 'demo').map((t) => t.data.media!.src!))];
---

<Base title={`${pillar.data.title} · Panagiotis Promponas`} description={pillar.data.lead}>
  {demoScripts.map((src) => <script slot="head" is:inline src={src}></script>)}

  <section class="wrap page-hero">
    <div class="eyebrow">Research</div>
    <h1>{pillar.data.title}</h1>
    <p class="lead">{pillar.data.lead}</p>
    <div class="intro-body"><PillarIntro /></div>
  </section>

  <nav class="wrap subnav" aria-label="Threads in this area">
    {threads.map((t) => <a href={`#${t.id}`}>{t.data.title}</a>)}
  </nav>

  {sections.map(({ t, Content, papers, Demo }) => (
    <section class="wrap thread" id={t.id} aria-labelledby={`${t.id}-h`}>
      {t.data.draft && <span class="draft-note">Draft</span>}
      <h2 id={`${t.id}-h`}>{t.data.title}</h2>
      <p class="summary">{t.data.summary}</p>
      <div class="body"><Content /></div>

      {t.data.media?.type === 'video' && (
        <figure class="figure">
          <video controls preload="none" playsinline poster={t.data.media.poster} width="1280" height="720">
            <source src={t.data.media.src} type="video/mp4" />
            Your browser cannot play this video.
          </video>
          <figcaption><span>{t.data.media.caption}</span><span>Video · {t.data.media.duration}</span></figcaption>
        </figure>
      )}

      {Demo && (
        <figure class:list={['figure', { bare: t.data.media?.frame === false }]}>
          <div class="demo"><Demo theme="auto"></Demo></div>
          <figcaption><span>{t.data.media?.caption}</span><span>Interactive</span></figcaption>
        </figure>
      )}

      {papers.length > 0 && (
        <>
          <div class="eyebrow papers-label">Papers</div>
          <div class="pubs">{papers.map((p) => <PubEntry pub={p} />)}</div>
        </>
      )}
    </section>
  ))}
</Base>

<script>
  // Keep every embedded demo in step with the site theme toggle.
  function apply(theme: string) {
    document.querySelectorAll('.demo > *').forEach((el) => el.setAttribute('theme', theme));
  }
  const saved = document.documentElement.getAttribute('data-theme');
  if (saved) apply(saved);
  document.addEventListener('themechange', (e) => apply((e as CustomEvent<string>).detail));

  // A page opened on a thread (#id) scrolls there at once, but a demo above that thread still grows
  // when its data arrives, and the scroll then stops short of the heading. Once everything has loaded,
  // go to the thread again, unless the visitor has already moved or the browser is restoring an earlier
  // position (reload, back). The scroll stays animated like the first one: an instant jump while that
  // one is still running leaves Chrome a few pixels off.
  const arrival = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  if (location.hash.length > 1 && arrival?.type === 'navigate' && document.readyState !== 'complete') {
    let moved = false;
    const stop = () => { moved = true; };
    const kinds = ['wheel', 'touchstart', 'pointerdown', 'keydown'];
    kinds.forEach((k) => addEventListener(k, stop, { passive: true, once: true }));
    addEventListener('load', () => {
      kinds.forEach((k) => removeEventListener(k, stop));
      if (!moved) document.getElementById(location.hash.slice(1))?.scrollIntoView();
    }, { once: true });
  }
</script>
