---
import Base from '../../layouts/Base.astro';
import PillarBoxes from '../../components/PillarBoxes.astro';
import { getCollection } from 'astro:content';

const pillars = (await getCollection('pillars')).sort((a, b) => a.data.order - b.data.order);
const threads = await getCollection('threads');
---

<Base title="Research · Panagiotis Promponas" description="Research areas: quantum networks, distributed quantum computing, network control and optimization.">
  <section class="wrap page-hero">
    <h1>Research</h1>
    <p class="lead">The broad areas my work falls into, each with its own threads and papers.</p>
  </section>
  <section class="wrap research" style="padding-bottom: 40px">
    <PillarBoxes pillars={pillars} threads={threads} />
  </section>
</Base>
