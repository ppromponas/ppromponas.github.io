---
import Base from '../layouts/Base.astro';
---

<Base title="CV · Panagiotis Promponas" description="Curriculum vitae of Panagiotis Promponas.">
  <section class="wrap page-hero">
    <div class="eyebrow">Curriculum vitae</div>
    <h1>Panagiotis Promponas</h1>
    <p class="lead">Ph.D. candidate in Electrical and Computer Engineering at Yale University, advised by Leandros Tassiulas.</p>
    <div class="cv-actions">
      <a class="btn" href="/cv/Panos_Promponas_CV.pdf">Download PDF</a>
      <a class="btn" href="mailto:panagiotis.promponas@yale.edu">Email</a>
    </div>
  </section>

  <section class="wrap cv-section" id="education" aria-labelledby="education-h">
    <h2 id="education-h">Education</h2>
    <div class="cv-item">
      <div class="cv-when">2020 to 2026</div>
      <div class="cv-what">
        <strong>Ph.D. in Electrical &amp; Computer Engineering</strong>
        <span class="where">Yale University. M.S. and M.Phil. en route.</span>
      </div>
    </div>
    <div class="cv-item">
      <div class="cv-when">2013 to 2019</div>
      <div class="cv-what">
        <strong>Diploma in Electrical &amp; Computer Engineering</strong>
        <span class="where">National Technical University of Athens. Specialization in computer science, mathematics and networks.</span>
      </div>
    </div>
  </section>

  <section class="wrap cv-section" id="experience" aria-labelledby="experience-h">
    <h2 id="experience-h">Experience</h2>
    <div class="cv-item">
      <div class="cv-when">Aug 2020 to present</div>
      <div class="cv-what">
        <strong>Graduate Research Assistant</strong>
        <span class="where">Yale Institute for Network Science and Center for Quantum Networks</span>
        <ul>
          <li>Scheduling and resource-allocation algorithms for quantum entanglement networks, with mathematical models of switch architectures to analyze rate-fidelity tradeoffs.</li>
          <li>Models and analysis of large-scale communication networks, including sectorized wireless and sliced networks.</li>
        </ul>
      </div>
    </div>
    <div class="cv-item">
      <div class="cv-when">Aug 2024 to Feb 2025</div>
      <div class="cv-what">
        <strong>Applied Scientist Intern</strong>
        <span class="where">Amazon, Transportation Services</span>
        <ul><li>A queueing-theoretic framework and digital-twin simulator for trailer operations, modeling facilities as a network of queues to optimize control policies.</li></ul>
      </div>
    </div>
    <div class="cv-item">
      <div class="cv-when">Jul to Aug 2024</div>
      <div class="cv-what">
        <strong>Ph.D. Research Intern</strong>
        <span class="where">Cisco Systems</span>
        <ul><li>A measurement-based distributed quantum computing framework that compiles algorithms into two-qubit gates and measurements while minimizing network cost and quantum memory.</li></ul>
      </div>
    </div>
    <div class="cv-item">
      <div class="cv-when">May to Aug 2023</div>
      <div class="cv-what">
        <strong>Ph.D. Research Intern</strong>
        <span class="where">Cisco Systems</span>
        <ul><li>A gate-based distributed quantum computing compiler that translates a circuit into operations native to multiple processors, jointly optimizing entanglement generation, routing and teleportation.</li></ul>
      </div>
    </div>
    <div class="cv-item">
      <div class="cv-when">Jan to May 2022</div>
      <div class="cv-what">
        <strong>Graduate Teaching Fellow</strong>
        <span class="where">EENG 310, Signals and Systems, Yale University</span>
      </div>
    </div>
    <div class="cv-item">
      <div class="cv-when">Apr 2019 to Aug 2020</div>
      <div class="cv-what">
        <strong>Research Assistant</strong>
        <span class="where">Network Management and Optimal Design Laboratory, National Technical University of Athens</span>
        <ul><li>Satisfaction-game models of multi-user resource sharing, the minimum efficient satisfaction equilibrium, and distributed dynamics that provably converge to it.</li></ul>
      </div>
    </div>
  </section>

  <section class="wrap cv-section" id="awards" aria-labelledby="awards-h">
    <h2 id="awards-h">Honors and awards</h2>
    <div class="cv-list">
      <div><strong>Onassis Foundation Scholarship</strong> for graduate studies in electrical engineering, 2023 to 2026.</div>
      <div><strong>A.G. Leventis Foundation Scholarship</strong> for graduate studies in electrical engineering, 2021 to 2024.</div>
      <div><strong>Bodossaki Foundation Scholarship</strong> for graduate studies in electrical engineering, 2021 to 2025.</div>
      <div><strong>Gerondelis Foundation Award</strong> for academic excellence, 2020 to 2021.</div>
      <div><strong>NTUA Special Account for Research Funding Scholarship</strong> for academic excellence, 2019 to 2020.</div>
      <div><strong>Space Hellas "Dimitris Manolopoulos" Scholarship</strong> for academic excellence, 2019.</div>
      <div><strong>Best Paper Award</strong>, IFIP Wireless and Mobile Networking Conference, 2019.</div>
      <div><strong>Three NTUA Thomaidion Awards</strong> for publications on satisfaction equilibria and wireless resource management, 2019 to 2022.</div>
      <div><strong>Conference travel grants</strong> for IEEE INFOCOM 2023, IFIP Networking 2023 and IEEE ICC 2025.</div>
    </div>
  </section>

  <section class="wrap cv-section" id="service" aria-labelledby="service-h">
    <h2 id="service-h">Academic service</h2>
    <div class="cv-list">
      <div>Reviewer for IEEE JSAC, IEEE/ACM Transactions on Networking, IEEE Transactions on Communications, IEEE Transactions on Quantum Engineering, IEEE Communications Magazine, IEEE Access, WiOpt, MILCOM and SPAWC.</div>
    </div>
  </section>

  <section class="wrap cv-section" id="skills" aria-labelledby="skills-h">
    <h2 id="skills-h">Skills and languages</h2>
    <div class="cv-list">
      <div><strong>Networks.</strong> Quantum networks, distributed quantum computing, quantum network control, network optimization, resource allocation.</div>
      <div><strong>Optimization and learning.</strong> Mathematical modeling, algorithm design, stochastic and queueing optimization, reinforcement learning, game theory, approximation and heuristic algorithms.</div>
      <div><strong>Programming.</strong> Python, Java, C and C++, R, Matlab, Julia.</div>
      <div><strong>Languages.</strong> Greek, native. English, fluent.</div>
    </div>
  </section>
</Base>
